# moshimoshi — copy to .env.local and fill in.
# Leave both Supabase values empty to run the demo (mock data, no login).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Publishable (anon) key: Project Settings → API Keys. Safe to ship to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Live mode only: also show the sample people from the demo so a new community
# doesn't look empty. Chats with them stay on the device (simulated replies).
VITE_DEMO_PEOPLE=false

